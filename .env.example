# --- Google Cloud / Gemini (same variable names the official lab uses) ---
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=True

# --- CycleSite Copilot ---
# bigquery  = real data, read through the BigQuery MCP server and our own dataset
# synthetic = offline demo data, no BigQuery (Gemini is still needed to chat with the agent)
CYCLESITE_BACKEND=bigquery
CYCLESITE_DATASET=cyclesite            # our own dataset; must live in the US multi-region
CYCLESITE_BQ_LOCATION=US
CYCLESITE_MAX_BYTES_BILLED=10000000000 # 10 GB hard cap per agent query
CYCLESITE_MODEL=gemini-3.6-flash       # same model as the official lab; change if unavailable
